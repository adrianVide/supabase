###############################################
# 🔵 INSTANCE CONFIGURATION (EDIT FOR EACH INSTANCE)
###############################################

# Unique project name (no spaces, used for volume paths)
PROJECT_NAME=myproject1

# Unique container prefix (no spaces)
CONTAINER_PREFIX=default

# Subnet third octet (must be unique per instance)
# Example: instance 1 → 28, instance 2 → 29, instance 3 → 30
SUBNET_THIRD_OCTET=28

# Exposed ports (must be unique per instance)
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
ANALYTICS_PORT=4000

# Database configuration
POSTGRES_DB=supabase
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# 🔐 SECURITY SECRETS (GENERATE NEW FOR EACH INSTANCE)
# Generate JWT_SECRET with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Generate ANON_KEY using Supabase JWT generator or https://supabase.com/docs/guides/hosting/overview#api-keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Generate SERVICE_ROLE_KEY using Supabase JWT generator
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Generate PG_META_CRYPTO_KEY with: openssl rand -base64 32
PG_META_CRYPTO_KEY=your-super-secret-pg-meta-crypto-key

# Studio configuration
STUDIO_DEFAULT_ORGANIZATION=My Organization
STUDIO_DEFAULT_PROJECT=My Project

# OpenAI API Key (optional, for AI features)
OPENAI_API_KEY=

# Public URLs (update with your domain)
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=http://localhost:8000

# Auth configuration
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=true

# SMTP configuration (optional)
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASS=smtp_pass
SMTP_SENDER_NAME=Supabase

# Mailer URL paths
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Phone auth configuration
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Vault and security keys
# Generate SECRET_KEY_BASE with: openssl rand -base64 48
SECRET_KEY_BASE=your-super-secret-key-base-with-at-least-64-characters-long-keep-it-safe

# Generate VAULT_ENC_KEY with: openssl rand -base64 32
VAULT_ENC_KEY=your-super-secret-vault-encryption-key

# Pooler configuration
POOLER_TENANT_ID=tenant1
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=10

# PostgREST configuration
PGRST_DB_SCHEMAS=public,storage,graphql_public

# Image proxy configuration
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Functions configuration
FUNCTIONS_VERIFY_JWT=true

# Docker socket location
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Logflare tokens
# Generate with: openssl rand -base64 32
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-logflare-public-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-logflare-private-token

# Dashboard credentials (optional, for Kong dashboard)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

###############################################
# 🚫 DO NOT EDIT ANYTHING BELOW THIS LINE
###############################################

# These are derived values that should not need modification
